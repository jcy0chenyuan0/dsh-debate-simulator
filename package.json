{
  "name": "dsh-debate-simulator",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "DSH 辩论模拟插件：管理员调度、8 名辩手、评委计分、教练总结、轮次归档与 Word 汇总。",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcy0chenyuan0/dsh-debate-simulator.git"
  },
  "homepage": "https://github.com/jcy0chenyuan0/dsh-debate-simulator#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PUBLISH.md",
    "LICENSE",
    "docs/*.md",
    "docs/*.png"
  ],
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
